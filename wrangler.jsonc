{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiftcast",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // 静的ファイル(アプリ本体 /app/ など)はAssetsで配信。API と、サーバー描画ページ(トップ・週間天気・コラム)はWorkerを先に実行する。
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/robots.txt", "/sitemap.xml", "/", "/weather", "/weather/", "/about", "/check", "/today", "/glossary", "/app", "/app/", "/pressure", "/pressure/*", "/columns", "/columns/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiftcast",
      // Cloudflare上のD1 "shiftcast" のID
      "database_id": "de6edbd7-daa6-477c-b981-5f6e26661650",
      "migrations_dir": "migrations"
    }
  ],
  // 10分ごとに起動し、src/cron.js が気象取得(3h毎)・アメダス(毎時)・統計(10分)・翌日アラート(20時JST)を振り分ける。
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "ALERT_HOUR": "20",
    "WEATHER_INTERVAL_H": "3",
    "MIN_K": "5",
    "EXTRA_AREAS": "01,04,13,23,27,34,40,47",
    "ALL_AREAS": "0"
  }
  // Secrets（wrangler secret put / Actions で設定）: OPENWEATHER_API_KEY, FIREBASE_SERVICE_ACCOUNT,
  //   FIREBASE_WEB_CONFIG, FIREBASE_VAPID_KEY
}
