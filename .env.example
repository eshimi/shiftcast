PORT=3000
OPENWEATHER_API_KEY=        # 未設定ならデモデータで動作
EXTRA_AREAS=                # 例: 13,27（ユーザー未登録でも取得）
ALL_AREAS=0                 # 1で47都道府県すべて取得
ALERT_HOUR=20               # 翌日アラート判定時刻(JST)
WEATHER_INTERVAL_H=3
MIN_K=5                     # 地域統計を表示する最小アクティブ人数
SCHEDULER=on                # offで外部cron(npm run batch:*)運用
FIREBASE_SERVICE_ACCOUNT=   # サービスアカウントJSON or パス
FIREBASE_WEB_CONFIG=        # Web設定JSON(1行)
FIREBASE_VAPID_KEY=
